---
import "../styles/global.css";
import { carta } from "../lib/carta.ts";
import { negocio } from "../lib/negocio.ts";

interface Props { title?: string; description?: string }
const {
  title = "El Chachapoyano · Pollería, sierra y selva en Tarapoto",
  description = "Cocina andina y amazónica en Tarapoto: cuyes, truchas, cecinas, paiches y pollo. Más de 70 platos. Reserva o pide por WhatsApp.",
} = Astro.props;

const precios = carta.map((p) => p.precio);
// Con base "/El-Chachapoyano" las rutas que empiezan con "/" se rompen: todo pasa por base.
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const url = new URL(base, Astro.site).href;
// Schema.org Restaurant (§5). ponytail: sin "image" hasta tener la imagen para redes.
const schema = {
  "@context": "https://schema.org",
  "@type": "Restaurant",
  name: negocio.nombre,
  url,
  servesCuisine: ["Peruana", "Andina", "Amazónica"],
  telephone: `+${negocio.whatsapp}`,
  priceRange: `S/ ${Math.floor(Math.min(...precios))} – ${Math.ceil(Math.max(...precios))}`,
  acceptsReservations: true,
  address: {
    "@type": "PostalAddress",
    streetAddress: "Jr. San Pablo de la Cruz 359",
    addressLocality: "Tarapoto",
    addressRegion: "San Martín",
    addressCountry: "PE",
  },
  openingHoursSpecification: [
    { "@type": "OpeningHoursSpecification", dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Sunday"], opens: "10:00", closes: "17:00" },
    { "@type": "OpeningHoursSpecification", dayOfWeek: ["Friday", "Saturday"], opens: "10:00", closes: "22:00" },
  ],
  sameAs: [negocio.links.instagram, negocio.links.facebook, negocio.links.tripadvisor],
};
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Modo noche antes de pintar (evita el parpadeo blanco). Ver docs/contexto.md §6. -->
    <script is:inline>
      let t = null;
      try { t = localStorage.getItem("tema"); } catch {}
      if (t ? t === "oscuro" : matchMedia("(prefers-color-scheme: dark)").matches)
        document.documentElement.dataset.tema = "oscuro";
    </script>
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" href={`${base}favicon.ico`} />
    <link rel="canonical" href={url} />
    <meta property="og:url" content={url} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="restaurant" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <slot />
  </body>
</html>
